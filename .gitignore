# ============================================================
# VLM Fine-Tuning / Machine Learning
# ============================================================

# Datasets and generated training data (repository root only)
# Keep .gitkeep files to preserve the directory structure.

# Processed event logs
/data/processed/*
!/data/processed/.gitkeep

# Generated charts and annotations
/data/generated/*
!/data/generated/charts/
!/data/generated/annotations/

/data/generated/charts/*
!/data/generated/charts/.gitkeep

/data/generated/annotations/*
!/data/generated/annotations/.gitkeep

# Synthetic datasets
/data/synthetic/*
!/data/synthetic/.gitkeep

# Model weights, adapters, and checkpoints
/checkpoints/
/models/
/artifacts/
*.safetensors
*.ckpt
*.pt
*.pth

# Training outputs
/outputs/*
!/outputs/.gitkeep
/results/
/training_logs/

# Experiment tracking
/mlruns/
/mlartifacts/
/wandb/
/lightning_logs/
/tensorboard/

# Local Hugging Face cache
/.cache/huggingface/

# Local configuration and secrets
.env.*
!.env.example

# Temporary files
*.tmp
*.bak
.DS_Store
